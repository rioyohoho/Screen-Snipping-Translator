{
  "manifest_version": 3,
  "name": "Screen Snipping Translator",
  "version": "1.1",
  "description": "Snip any screen area, detect text with OCR, and translate instantly on any webpage.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open Screen Translator" },
  "side_panel": { "default_path": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/scripts.js", "content.js"]
    }
  ]
}